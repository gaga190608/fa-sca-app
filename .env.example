# Copie para .env.local (ou cadastre na Vercel em Settings → Environment Variables).

# IA — chave grátis do Groq (https://console.groq.com/keys).
# Sem ela, o app funciona sem IA: a conversa mostra caminhos prontos e o
# "Por onde eu começo?" é calculado no próprio celular.
GROQ_API_KEY=cole-sua-chave-aqui

# Opcional: força outro modelo do Groq sem mexer no código.
# GROQ_MODEL=

# Voz e transcrição — ElevenLabs (opcional; sem isso usa a voz e o ditado do celular).
# Várias chaves separadas por vírgula: o app faz rodízio quando uma não tem
# permissão ou fica sem cota. Cada chave precisa de "Text to Speech" e/ou "Speech to Text".
ELEVENLABS_API_KEYS=
# Voz principal (conta grátis não usa vozes da Voice Library; aí cai na reserva).
ELEVENLABS_VOICE_ID=UgBBYS2sOqTuMpoF3BR0
# ELEVENLABS_FALLBACK_VOICE=TX3LPaxmHKxFdv7VOQHJ
